{
  "name": "caseora-backend",
  "version": "1.0.0",
  "description": "Production-ready RESTful API backend for iPhone Back Cover E-commerce",
  "main": "dist/server.js",
  "scripts": {
    "start": "node init && node dist/server.js",
    "dev": "node init && ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "node init && tsup",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "prisma": "^5.14.0",
    "ts-node-dev": "^2.0.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "schema": "prisma/schema"
  }
}
